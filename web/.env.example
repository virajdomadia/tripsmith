# web/ — Next.js. Copy to web/.env.local for local dev (gitignored). Names from docs/04-technical-design.md §12.
# Local values below are dev defaults; production/preview values live in Vercel project `tripsmith` (set in S2f).

# Server-side base URL of the FastAPI api (rewrites/fetch). Local: uvicorn on 8000 (`pnpm dev`). Vercel: https://tripsmith-api.vercel.app (custom domain deferred) — set in S2f.
API_URL=http://localhost:8000
# Shared secret the api sends to /revalidate; must equal api REVALIDATE_SECRET. Generated (openssl rand -hex 32) — set in S2f.
REVALIDATE_SECRET=change-me
# Sentry project `tripsmith-web` (Next.js) DSN. Issued by Sentry — created in S2d, pushed in S2f. Empty = Sentry off.
# SENTRY_DSN covers the server + edge runtimes; the browser only sees NEXT_PUBLIC_* vars, so the same DSN
# (a DSN is public by design) goes in NEXT_PUBLIC_SENTRY_DSN as well — set in S8.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional: `1` makes the server/edge SDK log every envelope it sends (verifying delivery). Unset = quiet.
# SENTRY_DEBUG=1
# Public origin of the site (canonical URLs, sitemap, OG). Local: 3000. Vercel: https://tripsmith.vercel.app (custom domain deferred) — set in S2f.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WhatsApp number for the enquire CTA, E.164 digits without "+". Not a secret — set in S2f. Must equal api WHATSAPP_NUMBER (the visitor email prints it).
NEXT_PUBLIC_WHATSAPP_NUMBER=919845012345
# Demo owner login, shown prefilled on /admin/login and in the footer fine print (portfolio demo); must equal api OWNER_EMAIL / OWNER_PASSWORD. Generated — set in S2f.
NEXT_PUBLIC_DEMO_EMAIL=owner@tripsmith.demo
NEXT_PUBLIC_DEMO_PASSWORD=change-me
