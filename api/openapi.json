            "type": "string"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          }
        },
        "required": [
          "slug",
          "name"
        ],
        "title": "PackageRef",
        "type": "object"
      },
      "RangeFacet": {
        "properties": {
          "max": {
            "title": "Max",
            "type": "integer"
          },
          "min": {
            "title": "Min",
            "type": "integer"
          }
        },
        "required": [
          "min",
          "max"
        ],
        "title": "RangeFacet",
        "type": "object"
      },
      "SearchFacets": {
        "description": "What the filter panel offers — derived from the live catalog, never hard-coded.",
        "properties": {
          "budget": {
            "$ref": "#/components/schemas/RangeFacet",
            "description": "Cheapest / priciest starting price in rupees, rounded out to 1,000; 0/0 if none"
          },
          "destinations": {
            "description": "value = slug; display order",
            "items": {
              "$ref": "#/components/schemas/FacetOption"
            },
            "title": "Destinations",
            "type": "array"
          },
          "months": {
            "description": "value = YYYY-MM; upcoming months with a departure that has seats, soonest first",
            "items": {
              "$ref": "#/components/schemas/FacetOption"
            },
            "title": "Months",
            "type": "array"
          },
          "nights": {
            "$ref": "#/components/schemas/RangeFacet",
            "description": "Shortest / longest live package; 0/0 when none"
          },
          "themes": {
            "description": "Every theme in enum order; count may be 0",
            "items": {
              "$ref": "#/components/schemas/FacetOption"
            },
            "title": "Themes",
            "type": "array"
          }
        },
        "required": [
          "destinations",
          "themes",
          "months",
          "nights",
          "budget"
        ],
        "title": "SearchFacets",
        "type": "object"
      },
      "SortOrder": {
        "enum": [
          "price-asc",
          "price-desc",
          "duration"
        ],
        "title": "SortOrder",
        "type": "string"
      },
      "TestimonialOut": {
        "properties": {
          "city": {
            "title": "City",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "packageName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Packagename"
          },
          "packageSlug": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Null when unlinked or the package is not live",
            "title": "Packageslug"
          },
          "rating": {
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Rating",
            "type": "integer"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "name",
          "city",
          "text",
          "rating",
          "packageSlug",
          "packageName"
        ],
        "title": "TestimonialOut",
        "type": "object"
      },
      "Theme": {
        "enum": [
          "beach",
          "hills",
          "honeymoon",
          "family",
          "adventure",
          "heritage"
        ],
        "title": "Theme",
        "type": "string"
      },
      "ThemeOption": {
        "properties": {
          "label": {
            "title": "Label",
            "type": "string"
          },
          "value": {
            "$ref": "#/components/schemas/Theme"
          }
        },
        "required": [
          "value",
          "label"
        ],
        "title": "ThemeOption",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Tripsmith API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/destinations": {
      "get": {
        "operationId": "listDestinations",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DestinationList"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Error envelope (06 C0)"
          }
        },
        "summary": "Get Destinations",
        "tags": [
          "public"
        ]
      }
    },
    "/destinations/{slug}": {
      "get": {
        "operationId": "getDestination",
        "parameters": [
          {
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "title": "Slug",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
