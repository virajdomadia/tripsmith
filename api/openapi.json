  "info": {
    "title": "Tripsmith API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/destinations": {
      "get": {
        "operationId": "listDestinations",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DestinationList"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Error envelope (06 C0)"
          }
        },
        "summary": "Get Destinations",
        "tags": [
          "public"
        ]
      }
    },
    "/destinations/{slug}": {
      "get": {
        "operationId": "getDestination",
        "parameters": [
          {
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "title": "Slug",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DestinationDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Error envelope (06 C0)"
          }
        },
        "summary": "Get Destination Route",
        "tags": [
          "public"
        ]
      }
    },
