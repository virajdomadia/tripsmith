      }
    },
    "/packages": {
      "get": {
        "description": "R3 search. Every filter lives in `search_packages`; this only adds the cache header.",
        "operationId": "searchPackages",
        "parameters": [
          {
            "description": "Destination slugs (≤ 20); any of",
            "in": "query",
            "name": "destination",
            "required": false,
            "schema": {
              "description": "Destination slugs (≤ 20); any of",
              "items": {
                "type": "string"
              },
              "maxItems": 20,
              "title": "Destination",
              "type": "array"
            }
          },
          {
            "description": "Maximum starting price per person, in rupees",
            "in": "query",
            "name": "maxBudget",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "maximum": 10000000,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Maximum starting price per person, in rupees",
              "title": "Maxbudget"
            }
          },
          {
            "in": "query",
            "name": "nightsMin",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 30,
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Nightsmin"
            }
          },
          {
            "in": "query",
            "name": "nightsMax",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 30,
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Nightsmax"
            }
          },
          {
            "description": "Any of",
            "in": "query",
            "name": "themes",
            "required": false,
            "schema": {
              "description": "Any of",
              "items": {
                "$ref": "#/components/schemas/Theme"
              },
              "title": "Themes",
              "type": "array"
            }
          },
          {
            "description": "YYYY-MM: packages with a departure that month that still has seats",
            "in": "query",
            "name": "month",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "YYYY-MM: packages with a departure that month that still has seats",
              "title": "Month"
            }
          },
          {
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/SortOrder",
              "default": "price-asc"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PackageList"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Error envelope (06 C0)"
          }
        },
        "summary": "Get Packages",
        "tags": [
          "public"
        ]
      }
    },
    "/packages/{slug}": {
      "get": {
        "operationId": "getPackage",
        "parameters": [
          {
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "title": "Slug",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PackageDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Error envelope (06 C0)"
          }
        },
        "summary": "Get Package Route",
        "tags": [
          "public"
        ]
      }
    },
    "/packages/{slug}/departures": {
      "get": {
        "operationId": "getDeparturesForMonth",
        "parameters": [
          {
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "title": "Slug",
              "type": "string"
            }
          },
          {
            "description": "YYYY-MM; omitted or blank = all upcoming",
            "in": "query",
            "name": "month",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "YYYY-MM; omitted or blank = all upcoming",
              "title": "Month"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DepartureList"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Error envelope (06 C0)"
          }
        },
        "summary": "Get Departures Route",
        "tags": [
          "public"
        ]
      }
    },
    "/packages/{slug}/itinerary.pdf": {
      "get": {
        "operationId": "getItineraryPdf",
        "parameters": [
          {
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "title": "Slug",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/pdf": {}
            },
            "description": "The PDF (no Blob store)"
          },
          "302": {
            "description": "Redirect to the cached PDF"
          },
          "404": {
            "description": "Draft or unknown package"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Error envelope (06 C0)"
          }
        },
        "summary": "Get Itinerary Pdf",
        "tags": [
          "public"
        ]
      }
    }
  }
}
