                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Error envelope (06 C0)"
          }
        },
        "summary": "Get Destination Route",
        "tags": [
          "public"
        ]
      }
    },
    "/enquiries": {
      "post": {
        "operationId": "submitEnquiry",
