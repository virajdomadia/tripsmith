            "maxLength": 80,
            "minLength": 2,
            "title": "Name",
            "type": "string"
          },
          "packageSlug": {
            "anyOf": [
              {
                "maxLength": 80,
                "pattern": "^[a-z0-9-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Packageslug"
          },
          "phone": {
            "title": "Phone",
            "type": "string"
          },
          "preferredDates": {
            "anyOf": [
