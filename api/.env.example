# Neon pooled connection string (local dev: the `dev` branch)
DATABASE_URL=postgres://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Vercel Blob store connected to tripsmith-api (needed only by db:seed)
BLOB_READ_WRITE_TOKEN=
# Where the Next.js app lives; api POSTs revalidation there
WEB_URL=http://localhost:3000
SITE_URL=http://localhost:3000
REVALIDATE_SECRET=change-me
# Optional
SENTRY_DSN=
PORT=8787
