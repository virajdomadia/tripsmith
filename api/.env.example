# api/ — FastAPI (pydantic-settings, app/config.py). Copy to api/.env.local for local dev (gitignored).
# Every key from docs/04-technical-design.md §12. Production/preview values live in Vercel project `tripsmith-api` (set in S2f).

# --- Database (S2b: Neon) ---
# Neon pooled connection string for the `production` or `dev` branch (Neon's default branch is `production`, not `main`), rewritten to the asyncpg driver. Issued by Neon — set in S2b, pushed in S2f.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?ssl=require
# Dev/CI only: a throwaway database for pytest (local Postgres 18 or the Neon `dev` branch). Never set in Vercel; GitHub Actions gets it in S2f.
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tripsmith_test
# Migration target, read only by alembic (alembic/env.py) and required: migrations never fall back to DATABASE_URL, so a bare
# `alembic upgrade head` cannot hit production by accident. Leave it unset here; pass it per command
# (`ALEMBIC_URL=… uv run alembic upgrade head`). The pytest harness sets it to TEST_DATABASE_URL itself.
# ALEMBIC_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tripsmith
# Seed target, read only by scripts/seed.py (or pass --database-url) — required for the same reason, never DATABASE_URL.
# SEED_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tripsmith

# --- Auth (S2f: generated) ---
# Signs the owner session cookie. Generated with `openssl rand -hex 32` — set in S2f.
SESSION_SECRET=change-me
# The single owner login (seeded on first boot). Demo credentials, generated in S2f; mirrored to web NEXT_PUBLIC_DEMO_*.
OWNER_EMAIL=owner@tripsmith.demo
OWNER_PASSWORD=change-me

# --- Email (S2d: Resend) ---
# Resend API key. Issued by Resend — created in S2d, pushed in S2f.
RESEND_API_KEY=re_xxx
# From address. No verified domain yet (S2d), so Resend test mode: `onboarding@resend.dev` can only deliver to the owner inbox; switch to hello@virajdomadia.com once the domain is bought and verified.
EMAIL_FROM=Tripsmith <onboarding@resend.dev>
# Where new-enquiry notifications go. Set in S2f.
OWNER_NOTIFY_EMAIL=virajdomadia32@gmail.com
# WhatsApp number printed in the visitor confirmation email, E.164 digits without "+". Must equal web NEXT_PUBLIC_WHATSAPP_NUMBER.
WHATSAPP_NUMBER=919845012345

# --- Storage (S2c: Vercel Blob) ---
# Read/write token of the Vercel Blob store attached to `tripsmith-api` (package images, PDFs, admin cover uploads (F17)). Issued by Vercel — already in Vercel; exposed for local dev in S2c.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# --- Rate limiting / cache (S2c: Upstash Redis) ---
# Upstash Redis REST endpoint + token (region ap-south-1). Issued by Upstash — created in S2c, pushed in S2f.
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# --- Errors (S2d: Sentry) ---
# Sentry project `tripsmith-api` (Python) DSN. Issued by Sentry — created in S2d, pushed in S2f. Empty = Sentry off.
SENTRY_DSN=

# --- Payments (B4: Razorpay, test mode forever) ---
# Test-mode key pair from the Razorpay dashboard (Account & Settings → API keys). The key id is public (the order response
# hands it to Checkout.js); the secret signs nothing we send but verifies every payment signature. Unset = POST /bookings 503.
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx

# --- Cron ---
# Bearer token Vercel Cron sends to /cron/*. Generated with `openssl rand -hex 32` — set in S2f.
CRON_SECRET=change-me

# --- Cross-service URLs (already in Vercel; local values here) ---
# Origin of the Next.js web app (CORS allow-list, revalidate calls). Local: 3000. Vercel: https://tripsmith.vercel.app (custom domain deferred).
WEB_URL=http://localhost:3000
# Shared secret for POST {WEB_URL}/revalidate; must equal web REVALIDATE_SECRET. Generated — set in S2f.
REVALIDATE_SECRET=change-me
# Public origin used in emails and absolute links. Same as WEB_URL for v1.
SITE_URL=http://localhost:3000
