{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app/main.py": {
      "maxDuration": 30
    }
  },
  "regions": ["bom1"],
  "crons": [{ "path": "/cron/daily", "schedule": "30 19 * * *" }],
  "ignoreCommand": "git diff --quiet \"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\" HEAD -- ."
}
