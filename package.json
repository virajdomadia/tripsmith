{
  "name": "tripsmith",
  "private": true,
  "packageManager": "pnpm@11.5.1",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": { "prettier": "3.9.6", "typescript": "5.9.3" }
}
